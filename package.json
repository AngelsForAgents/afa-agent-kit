{
  "name": "@angelsforagents/afa-agent-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source toolkit for agents to discover AFA funding opportunities, prepare and validate machine-readable pitches, and submit applications.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "discover": "node scripts/discover.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:remote": "node scripts/validate.mjs --remote",
    "submit": "node scripts/submit.mjs",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "license": "Apache-2.0"
}
